{
	"name": "www",
	"private": true,
	"description": "browser save editor for games of Final Fantasy Pixel Remaster",
	"license": "MIT",
	"author": "arelive <me@are.moe> (https://are.moe)",
	"type": "module",
	"scripts": {
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:write": "oxfmt --write",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "bun tests/ui.ts",
		"check": "tsc --noEmit && bun run lint && bun run format && bun run test && bun run build && bun run test:ui",
		"clean": "rm -rf dist",
		"build": "bun run clean && vite build",
		"dev": "vite",
		"preview": "vite preview",
		"start": "bun run build && bun run preview"
	},
	"dependencies": {
		"@fontsource/press-start-2p": "^5.3.0",
		"@noble/hashes": "^2.4.0",
		"@tanstack/solid-form": "^1.33.5",
		"@tanstack/solid-router": "^1.170.43",
		"@tanstack/solid-table": "^9.3.1",
		"buffer": "^6.0.3",
		"ffpr": "workspace:*",
		"nes.css": "^2.3.0",
		"solid-js": "^1.9.17",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@modyfi/vite-plugin-yaml": "^1.1.1",
		"jsdom": "^30.1.3",
		"puppeteer-core": "^25.16.0",
		"sass-embedded": "^1.106.1",
		"vite": "^8.3.5",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "^5.0.5"
	},
	"packageManager": "bun"
}
