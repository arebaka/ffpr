{
	"name": "ffpr",
	"version": "0.6.0",
	"description": "save editor for games of Final Fantasy Pixel Remaster",
	"keywords": [
		"editor",
		"fantasy",
		"ffpr",
		"final",
		"pixel",
		"remaster",
		"save"
	],
	"homepage": "https://github.com/arebaka/ffpr",
	"bugs": {
		"url": "https://github.com/arebaka/ffpr/issues"
	},
	"license": "MIT",
	"author": "arelive <me@are.moe> (https://are.moe)",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/arebaka/ffpr.git"
	},
	"funding": {
		"type": "patreon",
		"url": "https://www.patreon.com/arelive"
	},
	"workspaces": [
		"www"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt --check",
		"format:write": "oxfmt --write",
		"test": "bun test",
		"check": "tsc --noEmit && bun run lint && bun run format && bun run test",
		"clean": "rm -rf dist",
		"build": "bun run clean && tsc",
		"www:test": "bun run --cwd www test",
		"www:check": "bun run --cwd www check",
		"www:clean": "bun run --cwd www clean",
		"www:build": "bun run --cwd www build",
		"www:dev": "bun run --cwd www dev",
		"www:preview": "bun run --cwd www preview",
		"prepublishOnly": "bun run check && bun run www:check && bun run build"
	},
	"dependencies": {
		"fflate": "^0.8.3",
		"rijndael-js": "^2.0.0"
	},
	"devDependencies": {
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.5",
		"@types/rijndael-js": "^1.0.2",
		"eslint-plugin-json": "^5.0.0",
		"eslint-plugin-perfectionist": "^5.13.0",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-security": "^4.2.0",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-toml": "^1.5.0",
		"eslint-plugin-yml": "^3.9.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "^7.0.2"
	},
	"packageManager": "bun"
}
