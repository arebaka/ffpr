{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["ESNext"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noEmit": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": false,
		"rootDir": "src",
		"outDir": "dist",
		"declarationDir": "dist"
	},
	"include": ["src"]
}
